# Copy to .env at the repository root on the deployment box. docker-compose
# auto-loads this file for ${VAR} substitution in docker-compose.prod.yml.
# api-platform/backend/.env.production (separate file, see its own .example)
# holds the rest of the backend's secrets.

# Real domain pointed at this box's IP — required for Caddy to obtain a TLS
# certificate via Let's Encrypt's HTTP-01 challenge.
DOMAIN=your-domain.com

# Shared secret between backend and opsmcp. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Baked into the client's static bundle at build time (Vite). VITE_API_URL is
# the same origin as DOMAIN since Caddy proxies /v1, /api, /health there.
VITE_API_URL=https://your-domain.com
VITE_CLERK_PUBLISHABLE_KEY=

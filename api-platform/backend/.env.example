PORT=8080
DATABASE_URL=postgresql://operations:operations@localhost:5432/operations

CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Comma-separated origins allowed to present a Clerk session token to this API.
# Must include the deployed frontend's origin in production.
AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:8080

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shared secret between this server and the Python compute layer (opsmcp).
# Generate with: openssl rand -hex 32
# Must match INTERNAL_API_SECRET in opsmcp's environment.
INTERNAL_API_SECRET=

# Base URL of the Python compute layer, used by POST /v1/solve.
SOLVER_URL=http://localhost:3001

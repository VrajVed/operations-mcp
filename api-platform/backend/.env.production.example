# Copy to api-platform/backend/.env.production on the deployment box and fill
# in real values. Loaded by docker-compose.prod.yml's `backend` service via
# env_file. SOLVER_URL and INTERNAL_API_SECRET are NOT set here — compose
# injects them so they stay consistent with the opsmcp container.

PORT=8080

# Per the project's database decision: production uses the existing Supabase
# project, not a container. Use the pooler connection string from the
# Supabase dashboard (Settings -> Database -> Connection pooling).
DATABASE_URL=

CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Must include the deployed frontend's origin, e.g. https://your-domain.com
AUTHORIZED_PARTIES=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
